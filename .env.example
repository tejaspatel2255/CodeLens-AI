# =========================================================================
#             CodeLens AI - Master Environment Configuration Template
# =========================================================================
# Rename this file to '.env' in the project root and populate your credentials.
# Keep the actual .env file private. NEVER commit active keys to Git!

# -------------------------------------------------------------------------
# 1. Express Backend Server Configurations
# -------------------------------------------------------------------------
PORT=5000
JWT_SECRET=your_super_secure_jwt_token_signature_secret_key_here

# -------------------------------------------------------------------------
# 2. AI Core API
# -------------------------------------------------------------------------
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# Optional: Token optimization for free Groq tier (~4,200 requests/day at 2048)
# GROQ_MAX_TOKENS=2048             # lower = more requests/day; raise for complex problems
# GROQ_GENERATE_REVIEW=false       # set to true to enable two-pass AI code review
# GROQ_GENERATE_MODEL=llama-3.3-70b-versatile
# GROQ_REVIEW_MODEL=llama-3.3-70b-versatile

# -------------------------------------------------------------------------
# 3. Supabase Core Database (PostgreSQL)
# -------------------------------------------------------------------------
# Obtain these credentials from your Supabase Project Settings > API
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_service_role_key_here

# -------------------------------------------------------------------------
# 4. Nodemailer Secure SMTP Authentication (Gmail App Passwords)
# -------------------------------------------------------------------------
# To trigger secure signup OTP emails, enter your sender email and password.
# For Gmail, generate a 16-character secure App Password under Security settings.
# If left blank, the server will auto-generate an Ethereal Test SMTP link on boot.
SMTP_USER=your_smtp_sender_gmail@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx

# -------------------------------------------------------------------------
# 5. Client Vite Configurations
# -------------------------------------------------------------------------
# The frontend uses these keys. Vite automatically loads root configurations.
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
VITE_API_URL=http://localhost:5000
