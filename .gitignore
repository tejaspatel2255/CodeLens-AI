/client/dist/
/client/dist-ssr/
/client/out/
dist/
build/
bin/
obj/

# ─── Logs ────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

